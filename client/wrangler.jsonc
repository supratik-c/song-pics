{
  // This is also used in the public *.workers.dev preview address.
  "name": "scribble-bops",
  "compatibility_date": "2026-07-23",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // Game navigation uses ?puzzle=YYYY-MM-DD, not client-side path routes.
    "not_found_handling": "404-page"
  },

  // www.scribblebops.com redirects to this canonical hostname via a
  // Cloudflare Single Redirect rule (dashboard config, not repo config)
  // rather than serving two canonical addresses.
  "routes": [{ "pattern": "scribblebops.com", "custom_domain": true }],

  "env": {
    // Private preview deployed from pull requests. `assets` and
    // `compatibility_date` are inheritable, so only identity and routing
    // differ from production.
    "dev": {
      "name": "scribble-bops-dev",

      // SECURITY: both must stay false. Cloudflare Access protects
      // dev.scribblebops.com at the edge, but a *.workers.dev address or a
      // Preview URL reaches the same Worker without passing that policy.
      "workers_dev": false,
      "preview_urls": false,

      "routes": [{ "pattern": "dev.scribblebops.com", "custom_domain": true }]
    }
  }
}
