# Cloudflare Workers Static Assets header rules. See
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# Rules ACCUMULATE — a request matching more than one block gets every
# matching header, and duplicate header names are comma-joined rather than
# overridden. Clear Cloudflare's default Cache-Control with "! Cache-Control"
# before setting a different one, so nothing gets a corrupt comma-joined
# value. Cloudflare's own default is:
#   Cache-Control: public, max-age=0, must-revalidate
# which is already the right behaviour for HTML documents and
# build-version.json (see client/src/platform/deploymentVersion.ts), so
# neither gets a rule here.

# Content-hashed bundles — filenames change on every build, so caching them
# forever is safe.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Puzzle content — every runtime URL is generated by resolvePublicPath and
# carries ?v=<buildId>, so a new deploy always requests a new cache key. Do
# not fetch anything under /content/ without going through
# resolvePublicPath, or this rule stops being safe.
/content/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
